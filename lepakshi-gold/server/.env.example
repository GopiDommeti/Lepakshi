# ── Hostinger MySQL ───────────────────────────────────────────────
# hPanel → Databases → MySQL Databases. Copy the values shown there.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u750189796_Lepakshi_gold
DB_USER=u750189796_lepakshi_gold
DB_PASSWORD=your-database-password

# Running from your laptop against Hostinger?
# hPanel → Databases → Remote MySQL → add your IP (or %), then set:
#   DB_HOST=your-hostinger-mysql-host

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Any long random string. Change it before going live.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the storefront runs in development (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Public site address, used in sitemap.xml and social meta tags
SITE_URL=http://localhost:5173
